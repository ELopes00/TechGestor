rules_version = '2';

// ---------------------------------------------------------------------------
// TechGestor 2.0 — Regras do Firebase Storage
// Anexos de chamados (14/08/2026, ver web/src/lib/dataService.ts
// anexarArquivo). Mesmo modelo de confiança do Firestore: qualquer
// autenticado lê/escreve, sem trava por "de quem é o chamado".
// ---------------------------------------------------------------------------
service firebase.storage {
  match /b/{bucket}/o {
    match /chamados/{chamadoId}/{arquivo} {
      allow read, write: if request.auth != null;
    }
  }
}
