# Copie para .env.local e preencha com as credenciais do SEU projeto Firebase.
# Expo SDK 49+ injeta variáveis com prefixo EXPO_PUBLIC_ automaticamente.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ⚠️ Mesmo aviso do /web: as credenciais reais do projeto techgestor-bd
# apontam pra produção. Use um projeto Firebase separado pra desenvolver
# esta tela antes de testar contra dados reais — ver web/.env.local.example
# pra mais contexto.
