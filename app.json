{
  "expo": {
    "name": "TechGestor",
    "slug": "techgestor",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "com.pedrogpn.techgestor",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "notification": {
      "vapidPublicKey": "BBhYCB8zuQtu-d1MVsFhcaWngZ1OR3Q0ubzWCIt28q5sT3YmTaDFrqk5eAXh6pVsLcCe5sU-HXO-kqGRGysS1Og"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O TechGestor necessita de acesso à câmara para a leitura de códigos e anexação de fotografias aos chamados."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O TechGestor necessita de acesso ao GPS para o registo de quilometragem em eventos externos."
        }
      ],
      "expo-notifications",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "b0198725-e695-4696-8706-ec75061f83cf"
      }
    }
  }
}