# Copie para .env.local e preencha com as credenciais do seu projeto Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Chave pública VAPID do projeto (Firebase Console → Configurações do
# projeto → Cloud Messaging → Certificados push da Web). Necessária pra
# ativar notificações no navegador (ver src/lib/push.ts).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ⚠️ ATENÇÃO: as credenciais reais do projeto techgestor-bd (extraídas do
# repositório fonte) apontam para o banco de dados EM PRODUÇÃO — o mesmo
# usado pelo site ao vivo, com dados reais de chamados/inventário/usuários.
# NÃO cole essas credenciais aqui para "só testar": qualquer criar/editar/
# excluir feito rodando `npm run dev` vai escrever direto na produção.
#
# Antes de rodar este projeto, crie um projeto Firebase separado (dev/teste)
# e use as credenciais dele, ou peça as credenciais reais só quando estiver
# pronto para de fato substituir o sistema em produção — e com o firestore.rules
# deste projeto já implantado antes de qualquer teste de escrita.
